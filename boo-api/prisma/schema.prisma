generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id            String   @id @default(uuid())
  nome          String
  descricao     String   @default("")
  sku           String?  @unique
  preco         Decimal  @db.Decimal(12, 2)
  estoque       Int      @default(0)
  tamanhos      Json     @default("[]")
  categoria     String   @default("Geral")
  esgotado      Boolean  @default(false)
  ultimaPeca    Boolean  @default(false)
  oculto        Boolean  @default(false)
  cores         String[]
  imgUrl        String   @default("")
  pesoKg        Decimal  @default(0.5) @db.Decimal(8, 3)
  alturaCm      Int      @default(8)
  larguraCm     Int      @default(20)
  comprimentoCm Int      @default(28)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
  excluidoEm    DateTime?
  imagens       Json     @default("[]")

  @@index([excluidoEm, oculto, criadoEm])
  @@index([categoria, oculto])
}

model User {
  id                    String           @id @default(uuid())
  nome                  String
  email                 String           @unique
  senha                 String
  cpf                   String?          @unique
  telefone              String?
  enderecoPadrao        Json?
  preferenciasConta     Json?
  role                  Role             @default(CLIENTE)
  emailVerifiedAt       DateTime?
  termsAcceptedAt       DateTime?
  termsVersion          String?
  marketingConsentAt    DateTime?
  tokenVersion          Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  pedidos               Pedido[]
  sessoes               RefreshSession[]
  tokensEmail           EmailToken[]
  logsAuditoria         AuditLog[]

  @@index([role, createdAt])
}

model Categoria {
  id       String   @id @default(uuid())
  nome     String   @unique
  criadoEm DateTime @default(now())
}

enum Role {
  ADMIN
  CLIENTE
}

enum TipoCupom {
  PERCENTUAL
  FIXO
}

model Pedido {
  id                String   @id @default(uuid())
  numero            Int      @default(autoincrement())
  usuarioId         String?
  usuario           User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  itens             Json     @default("[]")
  entrega           Json     @default("{}")
  formaPagamento    String
  frete             Json?
  pagamento         Json?
  cupom             Json?
  total             Decimal  @db.Decimal(12, 2)
  status            String   @default("aguardando_pagamento")
  expiraEmPagamento DateTime?
  estoqueRestaurado Boolean  @default(false)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@index([usuarioId, criadoEm])
  @@index([status, expiraEmPagamento])
  @@index([criadoEm])
}

model Configuracao {
  id             String   @id @default(uuid())
  lojaAberta     Boolean  @default(true)
  fraseTopo      String   @default("FRETE GRÁTIS ACIMA DE R$ 299")
  instagramUrl   String   @default("")
  emailSuporte   String   @default("")
  frete          Json?
  emailTemplates Json?
  atualizadoEm   DateTime @updatedAt
}

model Cupom {
  id             String    @id @default(uuid())
  nome           String
  codigo         String    @unique
  tipo           TipoCupom
  valor          Decimal   @db.Decimal(12, 2)
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())
  expiraEm       DateTime?
  usosMaximos    Int?
  usosUtilizados Int       @default(0)

  @@index([ativo, expiraEm])
}

enum EmailTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentWebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorNome  String
  acao       String
  entidade   String
  entidadeId String?
  detalhes   Json?
  ip         String?
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
  @@index([actorId, criadoEm])
  @@index([entidade, entidadeId])
}

model EmailOutbox {
  id               String              @id @default(uuid())
  destinatario     String
  assunto          String
  html             String
  evento           String
  status           EmailDeliveryStatus @default(PENDING)
  tentativas       Int                 @default(0)
  proximaTentativa DateTime            @default(now())
  providerId       String?
  ultimoErro       String?
  criadoEm         DateTime            @default(now())
  enviadoEm        DateTime?

  @@index([status, proximaTentativa])
  @@index([criadoEm])
}

model PaymentWebhookEvent {
  id               String               @id @default(uuid())
  transactionNsu   String               @unique
  payload          Json
  status           PaymentWebhookStatus @default(PENDING)
  tentativas       Int                  @default(0)
  proximaTentativa DateTime             @default(now())
  ultimoErro       String?
  criadoEm         DateTime             @default(now())
  processadoEm     DateTime?

  @@index([status, proximaTentativa])
  @@index([criadoEm])
}
