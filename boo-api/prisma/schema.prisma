generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id         String   @id @default(uuid())
  nome       String
  preco      Float
  estoque    Int      @default(0)
  tamanhos   Json     @default("[]")
  categoria  String   @default("Geral")
  esgotado   Boolean  @default(false)
  ultimaPeca Boolean  @default(false)
  oculto     Boolean  @default(false)
  cores      String[]
  imgUrl     String   @default("")
  criadoEm   DateTime @default(now())
  imagens    Json     @default("[]")
}

model User {
  id                    String   @id @default(uuid())
  nome                  String
  email                 String   @unique
  senha                 String
  cpf                   String?  @unique
  telefone              String?
  enderecoPadrao        Json?
  preferenciasConta     Json?
  role                  Role     @default(CLIENTE)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Categoria {
  id       String   @id @default(uuid())
  nome     String   @unique
  criadoEm DateTime @default(now())
}

enum Role {
  ADMIN
  CLIENTE
}

enum TipoCupom {
  PERCENTUAL
  FIXO
}

model Pedido {
  id             String   @id @default(uuid())
  numero         Int      @default(autoincrement())
  usuarioId      String?
  itens          Json     @default("[]")
  entrega        Json     @default("{}")
  formaPagamento String
  frete          Json?
  total          Float
  status         String   @default("aguardando_pagamento")
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
}

model Configuracao {
  id           String   @id @default(uuid())
  lojaAberta   Boolean  @default(true)
  fraseTopo    String   @default("FRETE GRÁTIS ACIMA DE R$ 299")
  instagramUrl String   @default("")
  emailSuporte String   @default("")
  frete        Json?
  atualizadoEm DateTime @updatedAt
}

model Cupom {
  id             String    @id @default(uuid())
  nome           String
  codigo         String    @unique
  tipo           TipoCupom
  valor          Float
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())
  expiraEm       DateTime?
  usosMaximos    Int?
  usosUtilizados Int       @default(0)
}
